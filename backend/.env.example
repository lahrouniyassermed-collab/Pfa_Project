# ============================================================
# MangerManger — Variables d'environnement
# Copie ce fichier en .env et remplis tes valeurs
# ============================================================

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/mangermanger

# Sécurité JWT
SECRET_KEY=change_cette_cle_super_secrete_en_production_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OpenAI (pour vérification screenshot tombola)
OPENAI_API_KEY=sk-...

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application

# Nom du restaurant
RESTAURANT_NAME=MangerManger
